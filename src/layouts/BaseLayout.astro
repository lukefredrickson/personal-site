---
import type { ComponentProps } from 'astro/types';
import BaseHead from '../components/BaseHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';

// The layout forwards BaseHead's props wholesale instead of restating them.
type Props = ComponentProps<typeof BaseHead>;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead {...Astro.props} />

		{/*
			Pre-paint theme init (ADR 0012). `is:inline` skips Astro's deferral,
			which would flash the wrong theme; inline scripts are not deduplicated,
			so this lives only in the base layout. `applyTheme` is global — the
			single owner of theme DOM state — and sits after BaseHead because it
			rewrites the theme-color metas.
		*/}
		<script is:inline>
			function applyTheme() {
				var stored = null;
				try {
					stored = localStorage.getItem('lfdev-theme');
				} catch {
					// Privacy modes throw on storage access; fall through to the OS.
				}
				var theme = stored === 'light' || stored === 'dark' ? stored : null;

				var root = document.documentElement;
				if (theme) root.setAttribute('data-theme', theme);
				else root.removeAttribute('data-theme');

				// The button is absent until <body> parses and on every swap; hence the guard.
				var toggle = document.querySelector('[data-theme-toggle]');
				if (toggle) {
					var dark = theme === null ? matchMedia('(prefers-color-scheme: dark)').matches : theme === 'dark';
					toggle.setAttribute('aria-pressed', dark ? 'true' : 'false');
				}

				// A stored choice pins one meta and disables the other; without
				// one, both track the OS.
				document.querySelectorAll('meta[name="theme-color"]').forEach(function (meta) {
					var scheme = meta.getAttribute('data-scheme');
					var media;
					if (theme === null) media = '(prefers-color-scheme: ' + scheme + ')';
					else if (theme === scheme) media = 'all';
					else media = 'not all';
					meta.setAttribute('media', media);
				});
			}

			applyTheme();
			document.addEventListener('astro:after-swap', applyTheme);

			// Cross-tab sync: `storage` fires only in the other same-origin tabs.
			// A null key means localStorage.clear(); applyTheme re-reads either way.
			window.addEventListener('storage', function (event) {
				if (event.key === 'lfdev-theme' || event.key === null) applyTheme();
			});
		</script>

		{/* Slot for one-off page head tags (an RSS link, a preload). */}
		<slot name="head" />
	</head>
	<body>
		<div class="page">
			<SiteHeader />
			<main>
				<slot />
			</main>
			<SiteFooter />
		</div>
	</body>
</html>

<style>
	/* The one content column: the header and the footer render inside it
	   and align with the page content. The gap is only the seam between them. */
	.page {
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
		min-height: 100vh;
		max-width: var(--page-max);
		margin-inline: auto;
		padding: var(--page-pad-top) var(--page-pad-x);
	}

	/* Holds the footer at the bottom of a short page. */
	main {
		flex: 1;
	}

	/* Narrow viewports get a smaller gutter. */
	@media (max-width: 40rem) {
		.page {
			padding-inline: var(--space-6);
		}
	}
</style>
