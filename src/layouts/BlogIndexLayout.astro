---
import FilterPill from '../components/FilterPill.astro';
import PostListItem from '../components/PostListItem.astro';
import type { Post } from '../lib/posts';
import { getTagCounts } from '../lib/tags';
import { tintOf } from '../lib/tints';
import BaseLayout from './BaseLayout.astro';

interface Props {
	/** Every published post; the pill counts cover the whole blog. */
	posts: Post[];
	/** The tag this page filters to; absent on `/blog/`, which shows everything. */
	activeTag?: string;
}

const { posts, activeTag } = Astro.props;

// The only variance between the index and a tag page: the visible posts
// and the active pill (ADR 0014).
const visible = activeTag ? posts.filter((post) => post.data.tags.includes(activeTag)) : posts;

// Posts arrive newest-first; the year groups keep that order.
const byYear = Map.groupBy(visible, (post) => post.data.pubDate.getUTCFullYear());

// UTC keeps a midnight-stamped date on its own day. The group heading
// carries the year; zero-padding stacks the mono dates evenly.
const dayOf = (post: Post) =>
	post.data.pubDate
		.toLocaleDateString('en-US', { month: 'short', day: '2-digit', timeZone: 'UTC' })
		.toLowerCase();

const tagCounts = getTagCounts(posts);

const LEDE = "Software, bikes, and whatever else I'm thinking about. Sometimes all three at once.";
---

{/* Tag pages are the same screen filtered; only the head meta differs
    (ADR 0014). Generated pages template their description. */}
<BaseLayout
	title={activeTag ? `Posts tagged ${activeTag}` : 'The blog'}
	description={activeTag ? `Every post tagged ${activeTag}. ${LEDE}` : LEDE}
>
	<div class="page">
		<header class="intro">
			<h1 class="title">The blog</h1>
			<p class="lede">{LEDE}</p>
		</header>

		{/* Filtering is navigation: each pill links to a built page, so the
		    filtered view is shareable and ships no JS (ADR 0010 §6). */}
		<nav class="filters" aria-label="Filter posts by tag">
			<FilterPill href="/blog/" label="everything" count={posts.length} active={!activeTag} />
			{
				tagCounts.map(({ tag, count }) => (
					<FilterPill
						href={`/blog/tags/${tag}/`}
						label={tag}
						count={count}
						tint={tintOf(tag)}
						active={tag === activeTag}
					/>
				))
			}
		</nav>

		{
			[...byYear].map(([year, group], index) => {
				const showExcerpts = index === 0;

				return (
					<section class="year">
						<h2 class="year-label">{year}</h2>
						{/* Rows sit in their own box: the section's gap would separate
						    them, and the last child drops its divider here. */}
						<div>
							{group.map((post) => (
								<PostListItem
									title={post.data.title}
									href={`/blog/${post.id}/`}
									date={dayOf(post)}
									excerpt={showExcerpts ? post.data.description : undefined}
									tags={post.data.tags.map((tag) => ({ tag, tint: tintOf(tag) }))}
									draft={post.data.draft}
								/>
							))}
						</div>
					</section>
				);
			})
		}
	</div>
</BaseLayout>

<style>
	.page {
		display: flex;
		flex-direction: column;
		gap: var(--space-7);
		max-width: var(--page-max);
		margin: 0 auto;
		padding: var(--page-pad-top) var(--page-pad-x) var(--space-8);
	}

	.intro {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.title {
		color: var(--ink);
		font-family: var(--font-display);
		font-size: var(--text-page-title);
		font-weight: var(--weight-voice);
		letter-spacing: var(--tracking-display);
		line-height: var(--leading-heading);
	}

	/* Measure in rem: the line length grows with the reader's font size
	   (ADR 0011 §3). */
	.lede {
		max-width: 30rem;
		color: var(--text-body);
		font-size: var(--text-article);
		line-height: var(--leading-body);
	}

	.filters {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2);
	}

	.year {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	/* Rows carry their own vertical padding; the gap separates only the
	   year heading. */
	.year-label {
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: var(--text-meta);
		font-weight: var(--weight-body);
		letter-spacing: var(--tracking-caps);
	}

	/* Narrow viewports get a smaller gutter. */
	@media (max-width: 40rem) {
		.page {
			padding-inline: var(--space-6);
		}
	}
</style>
