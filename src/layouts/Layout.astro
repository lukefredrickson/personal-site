---
import type { ComponentProps } from 'astro/types';
import BaseHead from '../components/BaseHead.astro';
import '../styles/global.css';

// The layout adds nothing to the head API, so it forwards BaseHead's props
// wholesale rather than restating them.
type Props = ComponentProps<typeof BaseHead>;

const headProps = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead {...headProps} />

		{/*
			Pre-paint theme init. `is:inline` opts out of Astro's default script
			handling, which emits deferred modules that run after first paint — that
			deferral is the flash of wrong theme. Inline scripts are not deduplicated,
			so this must live in the single base layout and never in a component.

			No stored value means no attribute, and CSS light-dark() resolves the OS
			preference natively — live OS changes included, zero JS involved. Only
			visitors who have used the toggle depend on this script.

			applyTheme is the single owner of theme DOM state: the <html> attribute,
			the toggle's aria-pressed, and which theme-color meta applies. It is a
			global on purpose — ThemeToggle re-runs it after a click. Re-running it on
			astro:after-swap costs nothing today and makes adopting <ClientRouter />
			later a pure addition: a swap replaces <html> attributes wholesale and
			never re-executes kept scripts.

			It sits after BaseHead rather than at the very top of the head because it
			rewrites the theme-color metas, which have to be in the DOM first. Still
			pre-paint either way — nothing renders until </head> is passed.
		*/}
		<script is:inline>
			function applyTheme() {
				var stored = null;
				try {
					stored = localStorage.getItem('lfdev-theme');
				} catch (err) {
					// Privacy modes throw on storage access; fall through to the OS.
				}
				var theme = stored === 'light' || stored === 'dark' ? stored : null;

				var root = document.documentElement;
				if (theme) root.setAttribute('data-theme', theme);
				else root.removeAttribute('data-theme');

				// Absent until <body> parses, and again on every swap — hence the guard.
				var toggle = document.querySelector('[data-theme-toggle]');
				if (toggle) {
					var dark = theme ? theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
					toggle.setAttribute('aria-pressed', dark ? 'true' : 'false');
				}

				// An override pins one meta and disables the other; without one, both
				// go back to tracking the OS.
				document.querySelectorAll('meta[name="theme-color"]').forEach(function (meta) {
					var scheme = meta.getAttribute('data-scheme');
					meta.setAttribute(
						'media',
						theme === null
							? '(prefers-color-scheme: ' + scheme + ')'
							: theme === scheme
								? 'all'
								: 'not all',
					);
				});
			}

			applyTheme();
			document.addEventListener('astro:after-swap', applyTheme);
		</script>

		{/* Escape hatch for one-off page tags (an RSS link, a preload) — cheaper
		    than widening the BaseHead props API for a single caller. */}
		<slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>
