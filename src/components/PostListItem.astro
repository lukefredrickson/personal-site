---
import DraftBadge from './DraftBadge.astro';
import TagPill, { type Tag } from './TagPill.astro';

interface Props {
	title: string;
	/** The post's page — `/blog/<slug>/`. */
	href: string;
	/** Pre-formatted: "jun 21" on the index, "jun 2026" on home rows. */
	date: string;
	/** The post's `description`. Index rows carry it; home rows don't. */
	excerpt?: string;
	tags?: Tag[];
	/** Shows the draft badge; true only in dev and on previews (ADR 0021). */
	draft?: boolean;
	/** Home "Writing" rows: tag chips move onto the title line. */
	compact?: boolean;
}

const { title, href, date, excerpt, tags = [], draft = false, compact = false } = Astro.props;
---

{/* List rows render no images; only the featured post card carries one. */}
<article class:list={['post-row', { compact }]}>
	{/* h3: rows sit under a section heading (home) or a year heading (index). */}
	<h3 class="title"><a href={href}>{title}</a></h3>
	<span class="date">{date}</span>
	{excerpt && <p class="excerpt">{excerpt}</p>}
	{/* The draft badge leads the chip row, ahead of the tags. */}
	{
		(draft || tags.length > 0) && (
			<div class="tags">
				{draft && <DraftBadge />}
				{tags.map(({ tag, tint }) => <TagPill tag={tag} tint={tint} />)}
			</div>
		)
	}
</article>

<style>
	.post-row {
		/* Containing block for the title link's row-wide hit area. */
		position: relative;
		display: grid;
		/* The title column flexes; the date column fits its content. */
		grid-template-columns: 1fr auto;
		align-items: baseline;
		column-gap: var(--space-3);
		row-gap: var(--space-1);
		padding: var(--space-4) 0;
		/* Dividers are 1px hairlines, not --border-w. */
		border-bottom: 1px solid var(--hairline);
	}

	/* The last row in a group draws no divider. */
	.post-row:last-child {
		border-bottom: none;
	}

	.title {
		grid-column: 1;
		font-family: var(--font-display);
		font-size: var(--text-item-title);
		font-weight: var(--weight-title);
		line-height: var(--leading-heading);
	}

	.title a {
		color: var(--ink);
		text-decoration: none;
	}

	/* The row takes the hover: a chip sits above the overlay (ADR 0038). */
	.post-row:hover .title a,
	.title a:focus-visible {
		color: var(--link);
	}

	.title a:focus-visible {
		outline: 2px solid var(--link);
		outline-offset: 2px;
	}

	@media (prefers-reduced-motion: no-preference) {
		.title a {
			transition: color var(--duration-fast) var(--ease);
		}
	}

	/* The overlay makes the whole row the target; a nested <a> is invalid
	   HTML. Row text stops being selectable. */
	.title a::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.date {
		grid-column: 2;
		grid-row: 1;
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-meta);
	}

	.excerpt {
		grid-column: 1 / -1;
		color: var(--text-body);
		font-size: var(--text-small);
		line-height: var(--leading-body);
	}

	.tags {
		grid-column: 1 / -1;
		/* Above the title link's overlay, so the chips stay clickable. */
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		gap: var(--space-2);
		flex-wrap: wrap;
	}

	/* Compact rows add a third column: chips sit on the title line,
	   before the date. */
	.compact {
		grid-template-columns: 1fr auto auto;
	}

	.compact .tags {
		grid-column: 2;
		grid-row: 1;
	}

	.compact .date {
		grid-column: 3;
	}

	/* Chips cannot wrap inside an auto column, so a narrow compact row
	   falls back to the default arrangement. */
	@media (max-width: 40rem) {
		.compact {
			grid-template-columns: 1fr auto;
		}

		.compact .tags {
			grid-column: 1 / -1;
			grid-row: auto;
		}

		.compact .date {
			grid-column: 2;
		}
	}
</style>
