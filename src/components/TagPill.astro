---
import type { Tint } from '../lib/tints';

/** One tag with its tint, as the cards and rows consume it. */
export interface Tag {
	/** Tag slug — the chip's label and its tag page (ADR 0014). */
	tag: string;
	/** The caller picks the tint; the chip owns no tag-to-tint map. */
	tint?: Tint;
}

interface Props {
	/** Tag slug: labels the chip and links its tag page (ADR 0014). Omit
	 * for non-tag badges ("latest", "draft"), which slot their label. */
	tag?: string;
	/** Only these chips carry color in a post row. */
	tint?: Tint;
	/** Outlined badge treatment, used for "latest". */
	outlined?: boolean;
}

const { tag, tint = 'neutral', outlined = false } = Astro.props;

const Element = tag ? 'a' : 'span';
const href = tag ? `/blog/tags/${tag}/` : undefined;
---

<Element class:list={['tag-pill', tint, { outlined }]} href={href}>
	<slot>{tag}</slot>
</Element>

<style>
	.tag-pill {
		display: inline-block;
		padding: var(--space-1) var(--space-2);
		border-radius: var(--radius-chip);
		font-family: var(--font-mono);
		font-size: var(--text-chip);
		/* Undoes the body's 1.5 line-height to tighten the chip. */
		line-height: normal;
		white-space: nowrap;
		text-decoration: none;
	}

	.neutral {
		background: var(--tint-neutral-bg);
		color: var(--text-body);
	}

	.blue {
		background: var(--tint-blue-bg);
		color: var(--tint-blue-fg);
	}

	.foam {
		background: var(--tint-foam-bg);
		color: var(--tint-foam-fg);
	}

	/* No tag maps to rose; rose is the draft badge's hue (ADR 0021). */
	.rose {
		background: var(--tint-rose-bg);
		color: var(--tint-rose-fg);
	}

	/* Last so it wins over the tints at equal specificity. */
	.outlined {
		/* The border replaces one pixel of padding per axis; outlined and
		   filled chips match in size. */
		padding: calc(var(--space-1) - 1px) calc(var(--space-2) - 1px);
		border: 1px solid var(--latest-border);
		background: var(--latest-bg);
		color: var(--latest-fg);
	}
</style>
