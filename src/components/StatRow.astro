---
/**
 * Row of stats — slot in `StatChip`s. The chips size themselves; the row
 * owns only the gap and the narrow-viewport wrap.
 */
---

<div class="stat-row"><slot /></div>

<style>
	.stat-row {
		display: flex;
		gap: var(--space-3);
	}

	/* Wrapping against StatChip's 40% flex-basis floor yields two
	   columns on narrow viewports. */
	@media (max-width: 40rem) {
		.stat-row {
			flex-wrap: wrap;
		}
	}
</style>
