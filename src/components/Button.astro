---
interface Props {
	/** `primary` is the one filled main action per view; `secondary` is
	 *  everything else. */
	variant?: 'primary' | 'secondary';
	/** Renders an `<a>` when set, a `<button>` otherwise. */
	href?: string;
}

const { variant = 'secondary', href } = Astro.props;

const Element = href ? 'a' : 'button';
---

<Element
	class:list={['button', { primary: variant === 'primary' }]}
	href={href}
	type={href ? undefined : 'button'}
>
	<slot />
</Element>

<style>
	.button {
		display: inline-flex;
		align-items: center;
		/* Separates the label from a slotted trailing icon. The icon's size
		   stays a call-site prop (ADR 0015). */
		gap: var(--space-1);
		padding: var(--space-2) var(--space-5);
		border: var(--border-w) solid var(--border-soft);
		border-radius: var(--radius-sm);
		background: var(--surface);
		box-shadow: var(--shadow-sm);
		color: var(--text-body);
		font-family: var(--font-display);
		font-size: var(--text-ui);
		font-weight: var(--weight-ui);
		/* Undoes the body's 1.5 line-height; padding alone sets the height. */
		line-height: normal;
		white-space: nowrap;
		text-decoration: none;
		cursor: pointer;
	}

	.button:hover,
	.button:focus-visible {
		background: var(--surface-raised);
	}

	.button:focus-visible {
		outline: 2px solid var(--link);
		outline-offset: 2px;
	}

	@media (prefers-reduced-motion: no-preference) {
		.button {
			transition: background-color var(--duration-fast) var(--ease);
		}
	}

	.primary {
		border-color: transparent;
		background: var(--btn-primary-bg);
		color: var(--btn-primary-fg);
		font-weight: var(--weight-title);
	}

	/* Last so it wins over the base hover at equal specificity. */
	.primary:hover,
	.primary:focus-visible {
		background: var(--btn-primary-bg-hover);
	}
</style>
