---
interface Props {
	/** `primary` is filled pine — the one main action per view (the résumé
	 *  link); `secondary` is everything else. */
	variant?: 'primary' | 'secondary';
	/** Renders an `<a>` when set, a `<button>` otherwise. */
	href?: string;
}

const { variant = 'secondary', href } = Astro.props;

const Element = href ? 'a' : 'button';
---

<Element
	class:list={['button', { primary: variant === 'primary' }]}
	href={href}
	type={href ? undefined : 'button'}
>
	<slot />
</Element>

<style>
	.button {
		display: inline-flex;
		align-items: center;
		/* Separates the label from a trailing icon the caller slots in. The icon's
		   own size stays a call-site prop — CSS here would beat it (ADR 0015). */
		gap: var(--space-1);
		/* The kit shows 18px horizontal; snapped to the spacing scale. */
		padding: var(--space-2) var(--space-5);
		border: var(--border-w) solid var(--border-soft);
		border-radius: var(--radius-btn);
		background: var(--surface);
		box-shadow: var(--shadow-sm);
		color: var(--text-body);
		font-family: var(--font-display);
		font-size: var(--text-ui);
		font-weight: var(--weight-ui);
		/* Undo the body's 1.5 so padding alone sets the button height. */
		line-height: normal;
		white-space: nowrap;
		text-decoration: none;
		cursor: pointer;
	}

	.primary {
		border-color: transparent;
		background: var(--btn-primary-bg);
		color: var(--btn-primary-fg);
		font-weight: var(--weight-title);
	}
</style>
