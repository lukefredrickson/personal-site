---
import ThemeToggle from './ThemeToggle.astro';

// The active nav item derives from the URL, not a prop; the base layout
// renders one header for every page. Everything outside the blog is work.
function currentSection(pathname: string): 'work' | 'blog' | undefined {
	if (pathname.startsWith('/blog')) return 'blog';
	// The 404 page belongs to neither section.
	if (pathname.startsWith('/404')) return undefined;
	return 'work';
}

const section = currentSection(Astro.url.pathname);
---

<header class="site-header">
	<a class="logo" href="/">lukefredrickson<span>.dev</span></a>
	<nav aria-label="Main">
		<a href="/" aria-current={section === 'work' ? 'page' : undefined}>work</a>
		<a href="/blog/" aria-current={section === 'blog' ? 'page' : undefined}>blog</a>
	</nav>
	<ThemeToggle />
</header>

<style>
	.site-header {
		display: flex;
		align-items: center;
		gap: var(--space-6);
		/* On the narrowest viewports the wordmark and the controls wrap
		   instead of shrinking. */
		flex-wrap: wrap;
		row-gap: var(--space-4);
	}

	/* Pushes the nav and the toggle to the right edge. */
	.logo {
		margin-right: auto;
		color: var(--ink);
		font-family: var(--font-logo);
		/* No job token covers a wordmark. */
		font-size: var(--font-size-lg);
		font-weight: var(--weight-title);
		text-decoration: none;
	}

	.logo span {
		color: var(--logo);
	}

	nav {
		display: flex;
		align-items: center;
		gap: var(--space-6);
	}

	nav a {
		color: var(--text-muted);
		font-family: var(--font-display);
		font-size: var(--text-ui);
		font-weight: var(--weight-ui);
		text-decoration: none;
		/* Reserved on every item so the current one does not shift the row.
		   Heavier than --border-w: an underline, not a border. */
		padding-bottom: 1px;
		border-bottom: 2.5px solid transparent;
	}

	/* The hover sets the color alone: the border marks the current page. */
	nav a:hover,
	nav a:focus-visible {
		color: var(--ink);
	}

	nav a:focus-visible {
		outline: 2px solid var(--link);
		outline-offset: 2px;
	}

	@media (prefers-reduced-motion: no-preference) {
		nav a {
			transition: color var(--duration-fast) var(--ease);
		}
	}

	nav a[aria-current='page'] {
		color: var(--ink);
		border-bottom-color: var(--link);
	}
</style>
