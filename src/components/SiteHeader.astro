---
import ThemeToggle from './ThemeToggle.astro';

// Active nav state derives from the URL, not a prop: the layout renders one
// header for every page and no page can get its own nav wrong. Everything
// outside the blog is work — except the 404, which is nowhere, so it lights
// neither item.
const { pathname } = Astro.url;
const section = pathname.startsWith('/blog') ? 'blog' : pathname.startsWith('/404') ? null : 'work';
---

<header class="site-header">
	<a class="logo" href="/">lukefredrickson<span>.dev</span></a>
	<nav aria-label="Main">
		<a href="/" aria-current={section === 'work' ? 'page' : undefined}>work</a>
		<a href="/blog/" aria-current={section === 'blog' ? 'page' : undefined}>blog</a>
	</nav>
	<ThemeToggle />
</header>

<style>
	.site-header {
		display: flex;
		align-items: center;
		gap: var(--space-6);
		/* Below the narrowest phones the wordmark and the controls stop sharing a
		   line; wrapping beats shrinking either. */
		flex-wrap: wrap;
		row-gap: var(--space-4);
	}

	/* Pushes the nav and the toggle to the right edge. */
	.logo {
		margin-right: auto;
		color: var(--ink);
		font-family: var(--font-display);
		/* No job token covers a wordmark. */
		font-size: var(--font-size-lg);
		font-weight: var(--weight-voice);
		text-decoration: none;
	}

	.logo span {
		color: var(--logo);
	}

	nav {
		display: flex;
		align-items: center;
		gap: var(--space-6);
	}

	nav a {
		color: var(--text-muted);
		font-family: var(--font-display);
		font-size: var(--text-ui);
		font-weight: var(--weight-ui);
		text-decoration: none;
		/* Reserved on every item so the current one does not shift the row.
		   Deliberately heavier than --border-w: an underline, not a border. */
		padding-bottom: 1px;
		border-bottom: 2.5px solid transparent;
	}

	nav a[aria-current='page'] {
		color: var(--ink);
		border-bottom-color: var(--link);
	}
</style>
