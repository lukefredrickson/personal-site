---
import { MapPin } from '@lucide/astro';
import type { ImageMetadata } from 'astro';
import Card from './Card.astro';
import LogoTile from './LogoTile.astro';

interface Props {
	school: string;
	degree: string;
	/** Subject only — the card supplies the "Minor in" label. */
	minor?: string;
	/** Graduation year, e.g. "2022" — the degree is a milestone, not a tenure. */
	dates: string;
	/** e.g. "Burlington, VT" — shown under the dates in the header. */
	location?: string;
	/** School mark. Required: no monogram fallback, there is one school. */
	logo: ImageMetadata;
}

const { school, degree, minor, dates, location, logo } = Astro.props;
---

{/* Header anatomy matches CompanyCard so the career history reads as one card
    family; the body is a line of credentials rather than a role timeline. */}
<Card>
	<Fragment slot="header">
		<LogoTile logo={logo} />
		{/* PROTOTYPE — all four location placements render; html[data-loc-variant]
		    (set by PrototypeLocationSwitcher) picks the visible one. */}
		<div class="identity">
			<div class="name-block">
				<h3 class="name">
					{school}
					{location && <span class="proto-loc proto-d badge">{location}</span>}
				</h3>
				{
					location && (
						<span class="proto-loc proto-b subline">
							<MapPin size={11} aria-hidden="true" />
							{location}
						</span>
					)
				}
			</div>
			<div class="meta">
				<span class="dates">
					{dates}{location && <span class="proto-loc proto-c inline-loc">&nbsp;·&nbsp;{location}</span>}
				</span>
				{
					location && (
						<span class="proto-loc proto-a location">
							<MapPin size={11} aria-hidden="true" />
							{location}
						</span>
					)
				}
			</div>
		</div>
	</Fragment>
	<p class="credentials">
		<span class="degree">{degree}</span>
		{minor && <span class="minor">Minor in {minor}</span>}
	</p>
</Card>

<style>
	.identity {
		display: flex;
		flex: 1;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--space-4);
	}

	.name {
		color: var(--ink);
		font-family: var(--font-display);
		font-size: var(--text-card-title);
		font-weight: var(--weight-title);
	}

	/* Dates and location stack on the right; baseline alignment against the
	   name comes from the stack's first line (the dates). */
	.meta {
		display: flex;
		flex: none;
		flex-direction: column;
		align-items: flex-end;
		gap: var(--space-1);
	}

	.dates {
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-meta);
	}

	.location {
		align-items: center;
		gap: var(--space-1);
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: var(--text-meta);
	}

	/* PROTOTYPE — variant plumbing and per-variant styling below. Fold the
	   winner in (restoring its display to a plain rule) and delete the rest. */
	.name-block {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	/* B: place belongs to the institution — a quiet subline under the name. */
	.subline {
		align-items: center;
		gap: var(--space-1);
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: var(--text-meta);
	}

	/* C: one metadata string — location rides the dates line. */
	.inline-loc {
		color: var(--text-faint);
	}

	/* D: location as a badge beside the title. */
	.badge {
		align-items: center;
		margin-left: var(--space-2);
		padding: 2px var(--space-2);
		border: var(--border-w) solid var(--border-strong);
		border-radius: 999px;
		background: var(--tint-neutral-bg);
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-meta);
		font-weight: normal;
		vertical-align: middle;
	}

	/* No attribute (production, or pre-switcher) falls back to A, the landed
	   design. Show rules out-specify the hide rule via the html selector. */
	.proto-loc {
		display: none;
	}

	:global(html:not([data-loc-variant])) .proto-a,
	:global(html[data-loc-variant='a']) .proto-a {
		display: flex;
	}

	:global(html[data-loc-variant='b']) .proto-b {
		display: flex;
	}

	:global(html[data-loc-variant='c']) .proto-c {
		display: inline;
	}

	:global(html[data-loc-variant='d']) .proto-d {
		display: inline-flex;
	}

	.credentials {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-2);
		padding: var(--space-5) var(--space-6);
	}

	/* Degree reads as a role title does; the minor sits under it in weight. */
	.degree {
		color: var(--ink);
		font-family: var(--font-display);
		font-size: var(--text-item-title);
		font-weight: var(--weight-title);
	}

	.minor {
		color: var(--text-muted);
		font-family: var(--font-body);
		font-size: var(--text-small);
	}

	/* Separator as a pseudo-element: punctuation between fields, not content. */
	.credentials > span + span::before {
		content: '·';
		margin-right: var(--space-2);
		color: var(--text-faint);
	}
</style>
