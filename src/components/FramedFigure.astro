---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

/**
 * Media and its alt text travel together — an image with no description is
 * not a state worth rendering. Omit both for the placeholder treatment.
 */
type Media = { src: ImageMetadata; alt: string } | { src?: undefined; alt?: undefined };

type Props = Media & {
	/** Media height in px — 240 for post heros, ~130 for photo pairs. */
	height?: number;
	/** Mono caption strip under the media; omit to drop the strip. */
	caption?: string;
	/** Flat tint behind the placeholder, in place of the default hatch. */
	tint?: 'pine' | 'gold' | 'sand' | 'green';
	/** Label drawn in the placeholder. */
	placeholder?: string;
	/** `photo` is the tighter-cornered treatment for in-body photo pairs. */
	variant?: 'figure' | 'photo';
};

// `src` and `alt` stay on `props`: narrowing `props.src` is what proves to
// TypeScript that `props.alt` came with it.
const props = Astro.props;
const { height = 240, caption, tint, placeholder, variant = 'figure' } = props;
---

<figure class:list={['frame', variant]}>
	{/* An inline custom property rather than `define:vars`, which would inline a
	    copy of this whole style block per figure on a photo-heavy post. */}
	<div class:list={['media', tint && `tint-${tint}`]} style={`--media-height: ${height}px`}>
		{props.src ? <Image src={props.src} alt={props.alt} /> : placeholder}
	</div>
	{caption && <figcaption class="caption">{caption}</figcaption>}
</figure>

<style>
	.frame {
		/* Clips the media to the rounded corners. */
		overflow: hidden;
		border: var(--border-w) solid var(--border-strong);
		border-radius: var(--radius-card);
	}

	.photo {
		border-radius: var(--radius-sm);
	}

	.media {
		display: flex;
		align-items: center;
		justify-content: center;
		height: var(--media-height);
		/* Faded-ink hatch marks the box as a placeholder; a real image covers it.
		   The 1.5px stroke on an 8px pitch is drawn geometry, not spacing. */
		background:
			repeating-linear-gradient(45deg, var(--placeholder-hatch) 0 1.5px, transparent 1.5px 8px),
			var(--surface);
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: var(--text-caption);
	}

	/* After `.media` so the flat tint replaces the hatch. */
	.tint-pine {
		background: var(--tint-pine);
	}

	.tint-gold {
		background: var(--tint-gold);
	}

	.tint-sand {
		background: var(--tint-sand);
	}

	.tint-green {
		background: var(--tint-green);
	}

	/* The frame sets the height, so the image crops rather than dictates it.
	   Beats the responsive-image defaults, which ship at `:where()` specificity. */
	.media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.caption {
		padding: var(--space-2) var(--space-5);
		border-top: var(--border-w) solid var(--border-strong);
		background: var(--surface);
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-caption);
	}
</style>
