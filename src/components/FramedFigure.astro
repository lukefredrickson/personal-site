---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Tint } from '../lib/tints';

/**
 * `src` and `alt` come together or not at all. Omit both for the
 * placeholder treatment.
 */
type Media = { src: ImageMetadata; alt: string } | { src?: undefined; alt?: undefined };

type Props = Media & {
	/** Media height in px — 240 for post heros, ~130 for photo pairs. */
	height?: number;
	/** Mono caption strip under the media; omit to drop the strip. */
	caption?: string;
	/** Flat tint behind the placeholder, in place of the default hatch. */
	tint?: Tint;
	/** Label drawn in the placeholder. */
	placeholder?: string;
	/** `photo` is the tighter-cornered treatment for in-body photo pairs. */
	variant?: 'figure' | 'photo';
};

// Narrowing `props.src` proves to TypeScript that `props.alt` is present.
const props = Astro.props;
const { height = 240, caption, tint, placeholder, variant = 'figure' } = props;
---

<figure class:list={['frame', variant]}>
	{/* An inline custom property; `define:vars` would copy this style
	    block per figure. */}
	<div class:list={['media', tint]} style={`--media-height: ${height}px`}>
		{props.src ? <Image src={props.src} alt={props.alt} /> : placeholder}
	</div>
	{caption && <figcaption class="caption">{caption}</figcaption>}
</figure>

<style>
	.frame {
		/* Clips the media to the rounded corners. */
		overflow: hidden;
		border: var(--border-w) solid var(--border-strong);
		border-radius: var(--radius-card);
	}

	.photo {
		border-radius: var(--radius-sm);
	}

	.media {
		display: flex;
		align-items: center;
		justify-content: center;
		height: var(--media-height);
		/* The hatch marks the placeholder; a real image covers it. The 1.5px
		   stroke on an 8px pitch is drawn geometry, not spacing. */
		background:
			repeating-linear-gradient(45deg, var(--placeholder-hatch) 0 1.5px, transparent 1.5px 8px),
			var(--surface);
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: var(--text-caption);
	}

	/* After `.media` so the flat tint replaces the hatch. */
	.neutral {
		background: var(--tint-neutral-bg);
	}

	.blue {
		background: var(--tint-blue-bg);
	}

	.foam {
		background: var(--tint-foam-bg);
	}

	.gold {
		background: var(--tint-gold-bg);
	}

	.rose {
		background: var(--tint-rose-bg);
	}

	/* The frame sets the height; the image crops to it. Overrides the
	   responsive-image defaults, which ship at `:where()` specificity. */
	.media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.caption {
		padding: var(--space-2) var(--space-5);
		border-top: var(--border-w) solid var(--border-strong);
		background: var(--surface);
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-caption);
	}
</style>
