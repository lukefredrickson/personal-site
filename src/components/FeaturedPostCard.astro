---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import DraftBadge from './DraftBadge.astro';
import TagPill, { type Tag } from './TagPill.astro';

/**
 * `hero` and `heroAlt` come together or not at all, mirroring the collection
 * schema's refinement. Omit both for the placeholder.
 */
type Hero = { hero: ImageMetadata; heroAlt: string } | { hero?: undefined; heroAlt?: undefined };

type Props = Hero & {
	title: string;
	/** The post's page — `/blog/<slug>/`. */
	href: string;
	/** Pre-formatted: date shape differs per screen, so the screen owns it. */
	date: string;
	/** The post's `description`. */
	excerpt?: string;
	tags?: Tag[];
	/** Shows the draft badge; true only in dev and on previews (ADR 0021). */
	draft?: boolean;
	/** Label drawn in the hatched frame while a post has no hero. */
	placeholder?: string;
};

// Narrowing `props.hero` proves to TypeScript that `props.heroAlt` is present.
const props = Astro.props;
const { title, href, date, excerpt, tags = [], draft = false, placeholder } = props;
---

{/* Only the newest post renders this card. Size and position mark it as
    latest, so there is no badge. */}
<article class="featured-post">
	<div class="media">
		{props.hero ? <Image src={props.hero} alt={props.heroAlt} /> : placeholder}
	</div>
	<div class="body">
		<div class="meta">
			{draft && <DraftBadge />}
			<span>{date}</span>
			{tags.map(({ tag, tint }) => <TagPill tag={tag} tint={tint} />)}
		</div>
		{/* h3: the card sits under a section heading on every screen that uses it. */}
		<h3 class="title"><a href={href}>{title}</a></h3>
		{excerpt && <p class="excerpt">{excerpt}</p>}
	</div>
</article>

<style>
	.featured-post {
		/* Containing block for the title link's card-wide hit area. */
		position: relative;
		/* Clips the media to the rounded corners. */
		overflow: hidden;
		border: var(--border-w) solid var(--border-strong);
		border-radius: var(--radius-card);
		background: var(--surface);
		box-shadow: var(--shadow-featured);
	}

	.media {
		display: flex;
		align-items: center;
		justify-content: center;
		/* 150px keeps the title above the fold on a phone. */
		height: 150px;
		border-bottom: var(--border-w) solid var(--border-strong);
		/* The hatch marks the placeholder; a real hero covers it. The 1.5px
		   stroke on an 8px pitch is drawn geometry, not spacing. */
		background:
			repeating-linear-gradient(45deg, var(--placeholder-hatch) 0 1.5px, transparent 1.5px 8px),
			var(--surface);
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: var(--text-caption);
	}

	/* The card sets the height; the hero crops to it. Overrides the
	   responsive-image defaults, which ship at `:where()` specificity. */
	.media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		padding: var(--space-5) var(--space-6);
	}

	.meta {
		/* Above the title link's overlay, so the tag chips stay clickable. */
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		gap: var(--space-3);
		/* Chips wrap to a second line rather than compress the date. */
		flex-wrap: wrap;
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-meta);
	}

	.title {
		font-family: var(--font-display);
		font-size: var(--text-card-title);
		font-weight: var(--weight-title);
		line-height: var(--leading-heading);
	}

	.title a {
		color: var(--ink);
		text-decoration: none;
	}

	/* The card, not the link: the chips sit above the overlay and the title
	   still answers a cursor over them. */
	.featured-post:hover .title a,
	.title a:focus-visible {
		color: var(--link);
	}

	.title a:focus-visible {
		outline: 2px solid var(--link);
		outline-offset: 2px;
	}

	@media (prefers-reduced-motion: no-preference) {
		.title a {
			transition: color var(--duration-fast) var(--ease);
		}
	}

	/* The overlay makes the whole card the target; a nested <a> is invalid
	   HTML. Card text stops being selectable. */
	.title a::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.excerpt {
		color: var(--text-body);
		font-size: var(--text-small);
		line-height: var(--leading-body);
	}
</style>
