---
// The spec's `left`/`right` props are dropped: the footer is site chrome
// rendered once by the layout, and its copy is factual and fixed. A build-time
// year beats a literal nobody remembers to bump.
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<span>© {year} luke fredrickson</span>
	<span>lukefredrickson.dev</span>
</footer>

<style>
	.site-footer {
		display: flex;
		justify-content: space-between;
		/* Both halves fit one line until the narrowest phones. */
		flex-wrap: wrap;
		gap: var(--space-2);
		padding-top: var(--space-5);
		border-top: 1px solid var(--hairline);
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-meta);
	}
</style>
