---
// Prop-less: the base layout renders the footer once with fixed copy.
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<span>© {year} luke fredrickson</span>
	<span>lukefredrickson.dev</span>
</footer>

<style>
	.site-footer {
		display: flex;
		justify-content: space-between;
		/* Both halves share one line except on the narrowest viewports. */
		flex-wrap: wrap;
		gap: var(--space-2);
		padding-top: var(--space-5);
		border-top: 1px solid var(--hairline);
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-meta);
	}
</style>
