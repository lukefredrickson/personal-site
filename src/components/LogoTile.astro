---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Tint } from '../lib/tints';

interface Props {
	/** Real logo. Replaces the slotted monogram and drops the tint behind it. */
	logo?: ImageMetadata;
	/** Tint behind a monogram; logos sit on the card instead. */
	tint?: Tint;
}

const { logo, tint = 'neutral' } = Astro.props;
---

<div class:list={['logo-tile', !logo && tint]}>
	{/* Decorative — the entity's name is always right beside the tile. Rendered
	    at twice the tile so the raster holds up on dense displays; CSS fits it. */}
	{logo ? <Image src={logo} alt="" width={88} /> : <slot />}
</div>

<style>
	.logo-tile {
		display: flex;
		align-items: center;
		justify-content: center;
		flex: none;
		width: 44px;
		height: 44px;
		border: var(--border-w) solid var(--border-strong);
		border-radius: var(--radius-sm);
		overflow: hidden;
		color: var(--ink);
		font-family: var(--font-display);
		font-size: var(--text-card-title);
		font-weight: var(--weight-voice);
	}

	/* The `<img>` comes out of `<Image>`, so reach it explicitly rather than
	   leaning on the scope attribute passing through a child component. */
	.logo-tile :global(img) {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.neutral {
		background: var(--tint-neutral-bg);
	}

	.blue {
		background: var(--tint-blue-bg);
	}

	.foam {
		background: var(--tint-foam-bg);
	}

	.gold {
		background: var(--tint-gold-bg);
	}

	.rose {
		background: var(--tint-rose-bg);
	}
</style>
