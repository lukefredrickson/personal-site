---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Tint } from '../lib/tints';

interface Props {
	/** Logo image. Replaces the slotted monogram and removes the tint. */
	logo?: ImageMetadata;
	/** Tint behind the monogram. Ignored when `logo` is set. */
	tint?: Tint;
}

const { logo, tint = 'neutral' } = Astro.props;
---

<div class:list={['logo-tile', !logo && tint]}>
	{/* Decorative: the name sits beside the tile. Rendered at twice
	    the tile size for dense displays; CSS fits it. */}
	{logo ? <Image src={logo} alt="" width={104} /> : <slot />}
</div>

<style>
	.logo-tile {
		display: flex;
		align-items: center;
		justify-content: center;
		flex: none;
		/* Matches the two-line header (name + location subline) beside it. */
		width: 52px;
		height: 52px;
		border: var(--border-w) solid var(--border-strong);
		border-radius: var(--radius-sm);
		overflow: hidden;
		color: var(--ink);
		font-family: var(--font-display);
		font-size: var(--text-card-title);
		font-weight: var(--weight-voice);
	}

	/* `<Image>` renders the `<img>`, outside this component's scope
	   attribute, so `:global` reaches it. */
	.logo-tile :global(img) {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.neutral {
		background: var(--tint-neutral-bg);
	}

	.blue {
		background: var(--tint-blue-bg);
	}

	.foam {
		background: var(--tint-foam-bg);
	}

	.gold {
		background: var(--tint-gold-bg);
	}

	.rose {
		background: var(--tint-rose-bg);
	}
</style>
