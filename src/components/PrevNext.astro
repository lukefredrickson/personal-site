---
import { MoveLeft, MoveRight } from '@lucide/astro';

interface Neighbor {
	title: string;
	href: string;
}

interface Props {
	/** The older post; omit on the first one. */
	prev?: Neighbor;
	/** The newer post; omit on the latest. */
	next?: Neighbor;
}

const { prev, next } = Astro.props;

// Both halves render identically, so the differences are data.
const sides = [
	{ side: 'prev', label: 'previous', icon: MoveLeft, post: prev, fallback: "that's the first one!" },
	{ side: 'next', label: 'next', icon: MoveRight, post: next, fallback: "that's the latest one!" },
];
---

<nav class="prev-next" aria-label="Nearby posts">
	{
		sides.map(({ side, label, icon: Icon, post, fallback }) => {
			const Element = post ? 'a' : 'div';
			return (
				<Element class:list={['card', side]} href={post?.href}>
					<span class="dir">
						<Icon size={13} /> {label}
					</span>
					<span class:list={['title', { faint: !post }]}>{post ? post.title : fallback}</span>
				</Element>
			);
		})
	}
</nav>

<style>
	.prev-next {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-4);
	}

	.card {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		padding: var(--space-3) var(--space-5);
		border: var(--border-w) solid var(--border-soft);
		border-radius: var(--radius-card);
		background: var(--surface);
		text-decoration: none;
	}

	/* Only a real neighbor is a link; only links get the shadow. */
	a.card {
		box-shadow: var(--shadow-sm);
	}

	.next {
		text-align: right;
	}

	.dir {
		display: flex;
		align-items: center;
		gap: var(--space-1);
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-meta);
	}

	/* Arrows point outward. row-reverse also packs the pair against the
	   right edge, under the right-aligned title. */
	.next .dir {
		flex-direction: row-reverse;
	}

	.title {
		color: var(--ink);
		font-family: var(--font-display);
		font-size: var(--text-item-title);
		font-weight: var(--weight-title);
		line-height: var(--leading-heading);
	}

	.faint {
		color: var(--text-faint);
	}

	/* Two side-by-side titles stop being readable on narrow viewports. */
	@media (max-width: 40rem) {
		.prev-next {
			grid-template-columns: 1fr;
		}
	}
</style>
