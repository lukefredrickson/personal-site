---
import { Font } from 'astro:assets';

interface Props {
  /** Page title. Omitted only by Home, which renders the bare site name. */
  title?: string;
  /** Meta description. Required: a missing one fails the typecheck. No
   * site-wide default — each page writes its own line. */
  description: string;
  /** Social-card image. Posts pass their hero; everything else falls back to the default card. */
  ogImage?: ImageMetadata;
  /** Present on blog posts only: switches og:type to `article` and adds its timestamps. */
  article?: { publishedTime: Date; modifiedTime?: Date };
}

const SITE_NAME = 'Luke Fredrickson';
const DEFAULT_OG_IMAGE = '/og-default.png';

/* Mirrors the light and dark --bg values as hex; meta content cannot read
   a custom property. The theme script picks which applies. */
const THEME_COLOR = { light: '#fefbf8', dark: '#211d38' };

const { title, description, ogImage, article } = Astro.props;

const pageTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
// Trailing-slash form, matching the static build's files. Building from
// the pathname drops query strings.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage?.src ?? DEFAULT_OG_IMAGE, Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{/* Media variants track the OS with no JS. The theme script rewrites
    `media` when a stored override wins. */}
<meta name="theme-color" data-scheme="light" media="(prefers-color-scheme: light)" content={THEME_COLOR.light} />
<meta name="theme-color" data-scheme="dark" media="(prefers-color-scheme: dark)" content={THEME_COLOR.dark} />

<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />

{/* Only the roman face preloads; italic and mono sit below the fold on
    every screen. */}
<Font cssVariable="--font-public-sans" preload={[{ style: 'normal', subset: 'latin' }]} />
<Font cssVariable="--font-fira-code" />

{/* og:title stays unsuffixed — card UIs already show the domain. */}
<meta property="og:title" content={title ?? SITE_NAME} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:type" content={article ? 'article' : 'website'} />
{article && <meta property="article:published_time" content={article.publishedTime.toISOString()} />}
{article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}

{/* Every page resolves to a 1200×630-class card, so the large variant
    always applies. Unfurlers read the og:* tags for the rest. */}
<meta name="twitter:card" content="summary_large_image" />
