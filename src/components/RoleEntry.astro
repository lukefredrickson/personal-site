---
interface Props {
	title: string;
	/** "Apr 2024 – now" — omit on single-role cards, where the header carries them. */
	dates?: string;
	/** Verb-first, high-level bullets; about three per role. */
	bullets?: string[];
	/** The role held today: accent dot and colored markers. One per page. */
	current?: boolean;
	/** Last role in the card: no rail below the dot, no bottom padding. */
	last?: boolean;
}

const { title, dates, bullets = [], current = false, last = false } = Astro.props;
---

<div class:list={['role', { current, last }]}>
	{/* Promotion ladder: the dot marks this role; the rail runs to the
	    next one. */}
	<div class="timeline">
		<span class="dot"></span>
		{!last && <span class="rail"></span>}
	</div>
	<div class="entry">
		<div class="heading">
			<h4 class="title">{title}</h4>
			{dates && <span class="dates">{dates}</span>}
		</div>
		{
			bullets.length > 0 && (
				<ul class="bullets">
					{bullets.map((bullet) => (
						<li>{bullet}</li>
					))}
				</ul>
			)
		}
	</div>
</div>

<style>
	.role {
		/* The dot sizes in rem to track the reader's font size (ADR 0030).
		   Its grid row is the title's first line box, which centers it. */
		--dot-size: 0.75rem;
		--title-line: calc(var(--text-item-title) * var(--leading-body));

		display: flex;
		gap: var(--space-5);
	}

	.timeline {
		display: grid;
		grid-template-rows: var(--title-line) 1fr;
		justify-items: center;
		flex: none;
		width: var(--dot-size);
	}

	.dot {
		align-self: center;
		width: var(--dot-size);
		height: var(--dot-size);
		border: var(--border-w) solid var(--marker-muted);
		border-radius: 50%;
		background: var(--surface);
	}

	.rail {
		width: var(--border-w);
		margin: var(--space-1) 0;
		background: var(--rail);
	}

	.current .dot {
		border-color: var(--dot-current-ring);
		background: var(--accent);
	}

	.entry {
		flex: 1;
		padding-bottom: var(--space-6);
	}

	.last .entry {
		padding-bottom: 0;
	}

	.heading {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--space-4);
	}

	/* The leading is explicit because --title-line reads it for the dot. */
	.title {
		color: var(--ink);
		font-family: var(--font-display);
		font-size: var(--text-item-title);
		font-weight: var(--weight-title);
		line-height: var(--leading-body);
	}

	.dates {
		flex: none;
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-meta);
	}

	.bullets {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		margin-top: var(--space-2);
		padding: 0;
		list-style: none;
	}

	.bullets li {
		display: flex;
		gap: var(--space-3);
		color: var(--text-body);
		font-family: var(--font-body);
		font-size: var(--text-small);
		line-height: var(--leading-body);
	}

	/* Marker as a pseudo-element: decorative; the bullet text stays a
	   clean string in the accessibility tree. */
	.bullets li::before {
		content: '▸';
		flex: none;
		color: var(--marker-muted);
		font-weight: var(--weight-title);
	}

	.current .bullets li::before {
		color: var(--bullet);
	}
</style>
