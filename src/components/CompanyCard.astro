---
import { MapPin } from '@lucide/astro';
import type { ImageMetadata } from 'astro';
import type { ComponentProps } from 'astro/types';
import Card from './Card.astro';
import LogoTile from './LogoTile.astro';

interface Props {
	name: string;
	/** e.g. "Feb 2023 – now" or "Sept – Dec 2020" — ranges use a spaced – (en-dash). */
	dates: string;
	/** e.g. "Burlington, VT" — a subline under the name in the header. */
	location?: string;
	/** Employer logo; falls back to the monogram when absent. */
	logo?: ImageMetadata;
	/** 1–2 letters, used until a real logo is supplied. */
	monogram?: string;
	/** Tint behind the monogram; the tile owns the palette. */
	tint?: ComponentProps<typeof LogoTile>['tint'];
}

const { name, dates, location, logo, monogram, tint } = Astro.props;
---

{/* One card per employer; single-role cards keep the same anatomy. Roles
    go in the default slot, newest first. */}
<Card>
	<Fragment slot="header">
		<LogoTile logo={logo} tint={tint}>{monogram}</LogoTile>
		<div class="identity">
			<div class="name-block">
				<h3 class="name">{name}</h3>
				{
					location && (
						<span class="location">
							<MapPin size={11} aria-hidden="true" />
							{location}
						</span>
					)
				}
			</div>
			<span class="dates">{dates}</span>
		</div>
	</Fragment>
	<div class="roles">
		<slot />
	</div>
</Card>

<style>
	.identity {
		display: flex;
		flex: 1;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--space-4);
	}

	.name {
		color: var(--ink);
		font-family: var(--font-display);
		font-size: var(--text-card-title);
		font-weight: var(--weight-title);
	}

	/* The dates baseline-align against the stack's first line (the name). */
	.name-block {
		display: flex;
		flex-direction: column;
		/* No gap: the line-height alone separates the lines. */
		gap: 0;
	}

	.dates {
		flex: none;
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-meta);
	}

	.location {
		display: flex;
		align-items: center;
		gap: var(--space-1);
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: var(--text-meta);
	}

	/* Optical correction of the pin against the mono caps. The svg comes
	   from the Lucide component, hence :global. */
	.location :global(svg) {
		margin-top: -1px;
	}

	/* Each role owns its bottom spacing (RoleEntry's `last`); the column
	   needs no gap. */
	.roles {
		display: flex;
		flex-direction: column;
		padding: var(--space-5) var(--space-6) var(--space-6);
	}
</style>
