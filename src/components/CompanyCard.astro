---
import { MapPin } from '@lucide/astro';
import type { ImageMetadata } from 'astro';
import type { ComponentProps } from 'astro/types';
import Card from './Card.astro';
import LogoTile from './LogoTile.astro';

interface Props {
	name: string;
	/** e.g. "Feb 2023 – now" or "Sept – Dec 2020" — ranges use a spaced – (en-dash). */
	dates: string;
	/** e.g. "Burlington, VT" — shown under the dates in the header. */
	location?: string;
	/** Employer logo; falls back to the monogram when absent. */
	logo?: ImageMetadata;
	/** 1–2 letters, used until a real logo is supplied. */
	monogram?: string;
	/** Tint behind the monogram; the tile owns the palette. */
	tint?: ComponentProps<typeof LogoTile>['tint'];
}

const { name, dates, location, logo, monogram, tint } = Astro.props;
---

{/* One card per employer — a single-role internship keeps the same anatomy so
    the cards match down the page. Roles go in the default slot, newest first. */}
<Card>
	<Fragment slot="header">
		<LogoTile logo={logo} tint={tint}>{monogram}</LogoTile>
		{/* PROTOTYPE — all four location placements render; html[data-loc-variant]
		    (set by PrototypeLocationSwitcher) picks the visible one. */}
		<div class="identity">
			<div class="name-block">
				<h3 class="name">
					{name}
					{location && <span class="proto-loc proto-d badge">{location}</span>}
				</h3>
				{
					location && (
						<span class="proto-loc proto-b subline">
							<MapPin size={11} aria-hidden="true" />
							{location}
						</span>
					)
				}
			</div>
			<div class="meta">
				<span class="dates">
					{dates}{location && <span class="proto-loc proto-c inline-loc">&nbsp;·&nbsp;{location}</span>}
				</span>
				{
					location && (
						<span class="proto-loc proto-a location">
							<MapPin size={11} aria-hidden="true" />
							{location}
						</span>
					)
				}
			</div>
		</div>
	</Fragment>
	<div class="roles">
		<slot />
	</div>
</Card>

<style>
	.identity {
		display: flex;
		flex: 1;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--space-4);
	}

	.name {
		color: var(--ink);
		font-family: var(--font-display);
		font-size: var(--text-card-title);
		font-weight: var(--weight-title);
	}

	/* Dates and location stack on the right; baseline alignment against the
	   name comes from the stack's first line (the dates). */
	.meta {
		display: flex;
		flex: none;
		flex-direction: column;
		align-items: flex-end;
		gap: var(--space-1);
	}

	.dates {
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-meta);
	}

	.location {
		align-items: center;
		gap: var(--space-1);
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: var(--text-meta);
	}

	/* PROTOTYPE — variant plumbing and per-variant styling below. Fold the
	   winner in (restoring its display to a plain rule) and delete the rest. */
	.name-block {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	/* B: place belongs to the institution — a quiet subline under the name. */
	.subline {
		align-items: center;
		gap: var(--space-1);
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: var(--text-meta);
	}

	/* C: one metadata string — location rides the dates line. */
	.inline-loc {
		color: var(--text-faint);
	}

	/* D: location as a badge beside the title. */
	.badge {
		align-items: center;
		margin-left: var(--space-2);
		padding: 2px var(--space-2);
		border: var(--border-w) solid var(--border-strong);
		border-radius: 999px;
		background: var(--tint-neutral-bg);
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-meta);
		font-weight: normal;
		vertical-align: middle;
	}

	/* No attribute (production, or pre-switcher) falls back to A, the landed
	   design. Show rules out-specify the hide rule via the html selector. */
	.proto-loc {
		display: none;
	}

	:global(html:not([data-loc-variant])) .proto-a,
	:global(html[data-loc-variant='a']) .proto-a {
		display: flex;
	}

	:global(html[data-loc-variant='b']) .proto-b {
		display: flex;
	}

	:global(html[data-loc-variant='c']) .proto-c {
		display: inline;
	}

	:global(html[data-loc-variant='d']) .proto-d {
		display: inline-flex;
	}

	/* Each role carries its own bottom spacing (RoleEntry's `last`), so the
	   column needs no gap. */
	.roles {
		display: flex;
		flex-direction: column;
		padding: var(--space-5) var(--space-6) var(--space-6);
	}
</style>
