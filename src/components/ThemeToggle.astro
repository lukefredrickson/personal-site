---
import { Moon, Sun } from '@lucide/astro';
---

{/* No props: the DOM is the source of truth (ADR 0012). The init script
    owns `aria-pressed`; the value here is the untouched-visitor default. */}
<button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false" aria-label="Dark mode">
	<Sun class="track sun" size={13} />
	<Moon class="track moon" size={13} />
	<span class="knob">
		<Sun class="sun" size={12} />
		<Moon class="moon" size={12} />
	</span>
</button>

<style>
	.theme-toggle {
		/* Light values; the two dark rules below flip all three. 28px of
		   travel lands the knob on the mirrored 2px inset. */
		--knob-x: 0;
		--sun-display: block;
		--moon-display: none;

		position: relative;
		flex: none;
		/* Every offset below is measured off the fixed 56×28 pill. */
		width: 56px;
		height: 28px;
		padding: 0;
		border: var(--border-w) solid var(--ink);
		border-radius: var(--radius-pill);
		background: var(--surface);
		box-shadow: var(--shadow-sm);
		cursor: pointer;
	}

	.theme-toggle:focus-visible {
		outline: 2px solid var(--link);
		outline-offset: 2px;
	}

	/* Both track icons are always visible and always muted; the knob covers
	   whichever one is active. */
	.track {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		color: var(--text-faint);
	}

	.track.sun {
		left: 7px;
	}

	.track.moon {
		right: 7px;
	}

	.knob {
		position: absolute;
		top: 2px;
		left: 2px;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 21px;
		height: 21px;
		border-radius: 50%;
		background: var(--ink);
		color: var(--bg);
		transform: translateX(var(--knob-x));
	}

	.knob .sun {
		display: var(--sun-display);
	}

	.knob .moon {
		display: var(--moon-display);
	}

	/* Animates only when the visitor allows motion. */
	@media (prefers-reduced-motion: no-preference) {
		.knob {
			transition: transform 0.18s ease;
		}
	}

	/* A stored choice. CSS positions the knob, so it is correct pre-paint
	   and after a client-router swap. */
	html[data-theme='dark'] .theme-toggle {
		--knob-x: 28px;
		--sun-display: none;
		--moon-display: block;
	}

	/* No stored choice: the OS decides, as the color tokens do. A media
	   query cannot join the selector, so the values repeat. */
	@media (prefers-color-scheme: dark) {
		html:not([data-theme='light']) .theme-toggle {
			--knob-x: 28px;
			--sun-display: none;
			--moon-display: block;
		}
	}
</style>

<script>
	// Declared by the pre-paint init script in the base layout (ADR 0012),
	// the single owner of theme DOM state.
	declare function applyTheme(): void;

	const STORAGE_KEY = 'lfdev-theme';

	// Delegated: bundled scripts run once; a listener on the button would
	// be lost on a client-router swap.
	document.addEventListener('click', (event) => {
		const target = event.target;
		if (!(target instanceof Element) || !target.closest('[data-theme-toggle]')) return;

		// The attribute exists only for a stored choice; otherwise the OS
		// value is the one to flip.
		const chosen = document.documentElement.dataset.theme;
		const dark = chosen ? chosen === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
		try {
			localStorage.setItem(STORAGE_KEY, dark ? 'light' : 'dark');
		} catch {
			// Privacy modes throw. A choice lives in storage; with none,
			// there is nothing to apply.
			return;
		}
		applyTheme();
	});

	// The head script runs before <body> exists and cannot see this button.
	// Only the announced state depends on this correction.
	applyTheme();
</script>
