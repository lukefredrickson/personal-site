---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	name?: string;
	/** Short lowercase-ish descriptor, ending with a period. */
	blurb?: string;
	/** Where "more about me" points. */
	href?: string;
	/** The words it points with. */
	linkLabel?: string;
	/** Headshot; without one the frame stays a dot-matrix placeholder. */
	photo?: ImageMetadata;
}

const {
	name = 'Luke Fredrickson',
	blurb = 'full-stack engineer, front-end focus.',
	href = '/',
	linkLabel = 'home page',
	photo,
} = Astro.props;
---

{/* Bio beside the post it closes, not part of it. */}
<aside class="author-card">
	{/* The declared width is the rendered width: without it the responsive
	    pipeline sizes a full-bleed image and ships megabytes for a 52px thumb. */}
	<div class="photo">{photo && <Image src={photo} alt={name} width={52} />}</div>
	{/* The sentence around the link is boilerplate, not content — one author,
	    one destination, and only the words worth varying are props. */}
	<p class="bio">
		<b>{name}</b> — {blurb} More about me + career highlights on the <a class="inline-link" href={href}>{linkLabel}</a>.
	</p>
</aside>

<style>
	.author-card {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		padding: var(--space-4) var(--space-5);
		border: var(--border-w) solid var(--border-strong);
		border-radius: var(--radius-card);
		background: var(--surface);
	}

	.photo {
		/* Square thumb, never squeezed by a long bio. */
		flex: none;
		width: 52px;
		height: 52px;
		overflow: hidden;
		border: var(--border-w) solid var(--border-strong);
		border-radius: var(--radius-sm);
		/* Dot matrix shows through until a headshot is passed. Drawn geometry. */
		background:
			radial-gradient(var(--placeholder-dot) 1px, transparent 1.1px) 0 0 / 7px 7px, var(--surface);
	}

	.photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.bio {
		flex: 1;
		color: var(--text-body);
		font-size: var(--text-small);
		line-height: var(--leading-body);
	}

	.bio b {
		color: var(--ink);
		font-family: var(--font-display);
		font-weight: var(--weight-title);
	}
</style>
