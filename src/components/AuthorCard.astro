---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	name?: string;
	/** Short lowercase-ish descriptor, ending with a period. */
	blurb?: string;
	/** Where "more about me" points, and the words it points with. */
	href?: string;
	linkLabel?: string;
	/** Headshot; without one the frame stays a dot-matrix placeholder. */
	photo?: ImageMetadata;
}

const {
	name = 'Luke Fredrickson',
	blurb = 'full-stack engineer, front-end focus.',
	href = '/',
	linkLabel = 'home page',
	photo,
} = Astro.props;
---

{/* Bio beside the post it closes, not part of it. */}
<aside class="author-card">
	<div class="photo">{photo && <Image src={photo} alt={name} />}</div>
	{/* The sentence around the link is chrome, not content — one author, one
	    destination, and only the words worth varying are props. */}
	<p class="bio">
		<b>{name}</b> — {blurb} More about me + career highlights on the <a href={href}>{linkLabel}</a>.
	</p>
</aside>

<style>
	.author-card {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		/* 18px sits off the spacing scale; it is the kit's card padding. */
		padding: var(--space-4) 18px;
		border: var(--border-w) solid var(--border-strong);
		border-radius: var(--radius-card);
		background: var(--surface);
	}

	.photo {
		/* Square thumb, never squeezed by a long bio. */
		flex: none;
		width: 52px;
		height: 52px;
		overflow: hidden;
		border: var(--border-w) solid var(--border-strong);
		border-radius: var(--radius-sm);
		/* Dot matrix shows through until a headshot is passed. Drawn geometry. */
		background:
			radial-gradient(var(--placeholder-dot) 1px, transparent 1.1px) 0 0 / 7px 7px, var(--surface);
	}

	.photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.bio {
		flex: 1;
		color: var(--text-body);
		font-size: var(--text-small);
		line-height: var(--leading-body);
	}

	.bio b {
		color: var(--ink);
		font-family: var(--font-display);
		font-weight: 700;
	}

	.bio a {
		border-bottom: var(--border-w) solid var(--link);
		color: var(--link);
		font-weight: 600;
		text-decoration: none;
	}
</style>
