---
interface Props {
	/** Hard offset shadow. Only the featured post card sets it. */
	shadow?: boolean;
	/** Soft border for secondary content, e.g. prev/next. */
	quiet?: boolean;
}

const { shadow = false, quiet = false } = Astro.props;
---

{/* The caller owns the body padding: contents range from padded role
    lists to full-bleed hero images. */}
<div class:list={['card', { shadow, quiet }]}>
	{
		Astro.slots.has('header') && (
			<div class="header">
				<slot name="header" />
			</div>
		)
	}
	<slot />
</div>

<style>
	.card {
		/* One line color for the outline and the header rule; `quiet`
		   changes both here. */
		--card-line: var(--border-strong);

		border: var(--border-w) solid var(--card-line);
		border-radius: var(--radius-card);
		background: var(--surface);
		/* Clips the header strip's background to the rounded corners. */
		overflow: hidden;
	}

	.quiet {
		--card-line: var(--border-soft);
	}

	.shadow {
		box-shadow: var(--shadow-card);
	}

	.header {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		padding: var(--space-5) var(--space-6);
		border-bottom: var(--border-w) solid var(--card-line);
		background: var(--surface-raised);
	}
</style>
