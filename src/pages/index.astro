---
import { ExternalLink, FileText, MoveRight, Send } from '@lucide/astro';
import { Image } from 'astro:assets';
import energyhubLogo from '../assets/energyhub.jpeg';
import headshot from '../assets/luke-headshot.jpg';
import packetizedLogo from '../assets/packetized-energy.png';
import uvmShield from '../assets/uvm-shield.svg';
import Button from '../components/Button.astro';
import CompanyCard from '../components/CompanyCard.astro';
import FeaturedPostCard from '../components/FeaturedPostCard.astro';
import PostListItem from '../components/PostListItem.astro';
import RoleEntry from '../components/RoleEntry.astro';
import SectionTitle from '../components/SectionTitle.astro';
import type { Tag } from '../components/TagPill.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatPostDate, getPublishedPosts } from '../lib/posts';
import { tintOf } from '../lib/tints';

// The newest post leads the section; the rest are rows. Four keeps the home
// list a teaser — /blog/ is where the archive lives.
const [featured, ...older] = await getPublishedPosts();
const recent = older.slice(0, 4);

// Tinting is the screen's call, off the one shared map — the chip takes a tint,
// not a vocabulary.
const chips = (tags: string[]): Tag[] => tags.map((tag) => ({ tag, tint: tintOf(tag) }));

// The schema pairs a hero with its alt text; testing both is what proves that
// pairing to TypeScript here, where the card takes them as a unit.
const hero =
	featured?.data.hero && featured.data.heroAlt
		? { hero: featured.data.hero, heroAlt: featured.data.heroAlt }
		: {};
---

{/* Home is the one page with no `title`, so it renders the bare site name. */}
<BaseLayout
	description="Luke Fredrickson — frontend-primary full-stack engineer. I build products end to end and write about what I learn along the way."
>
	<div class="page">
		<header class="hero">
			<Image class="portrait" src={headshot} alt="Luke Fredrickson" width={150} />
			<div class="greeting">
				<h1>Hey, I'm <span class="mark">Luke</span></h1>
				<p class="intro">
					Frontend-primary full-stack engineer. I build products end to end and write about what I
					learn along the way.
				</p>
			</div>
		</header>

		<div class="links">
			<Button variant="primary" href="/resume.pdf">resume <FileText size={13} /></Button>
			<Button href="https://github.com/lukefredrickson">github <ExternalLink size={13} /></Button>
			<Button href="https://www.linkedin.com/in/luke-fredrickson/">
				linkedin <ExternalLink size={13} />
			</Button>
			<Button href="mailto:hello@lukefredrickson.dev">email <Send size={13} /></Button>
		</div>

		<section class="section">
			<SectionTitle>Where I've worked</SectionTitle>

			{/* Every claim here traces to the approved bullet library in
			    resume-builder — same facts as the resume, friendlier sentences. */}
			<CompanyCard name="EnergyHub" dates="Feb 2023 – now" location="Remote: Seattle, WA" logo={energyhubLogo}>
				<RoleEntry
					current
					title="Software Engineer II"
					dates="Apr 2024 – now"
					bullets={[
						'Took an embedded analytics platform from spec to production as its sole technical owner — JWT auth on a Java/Spring endpoint, React embed components, docs the next engineers ran with',
						'Helped haul a customer-facing portal out of a Java monolith: Backbone.js and jQuery views rewritten in React, at parity, behind feature flags',
						'Built the customer-facing side of a new grid load-shaping product across React and Java; it launched on deadline with five utilities on it',
					]}
				/>
				<RoleEntry
					last
					title="Software Engineer I"
					dates="Feb 2023 – Apr 2024"
					bullets={[
						'Built the React/TypeScript front end of an internal config tool with three other engineers — manual program setup became something non-technical folks could do themselves',
						"Moved that tool onto schema-based form validation (React Hook Form and Yup) and wrote the shared docs that became the team's reference",
						"Shipped front-end work for the EV managed-charging launch: utilities on one side, people's actual cars on the other",
					]}
				/>
			</CompanyCard>

			{/* Carries the timeline across the gap between employers. */}
			<div class="connector" aria-hidden="true"></div>

			<CompanyCard
				name="Packetized Energy"
				dates="Sept – Dec 2020"
				location="Burlington, VT"
				logo={packetizedLogo}
			>
				<RoleEntry
					last
					title="Software Developer Intern"
					bullets={[
						'Shipped features across the React/Redux front end and AWS Lambda back end of a SPA for managing distributed energy resources',
						'Later acquired by EnergyHub — which is how these two cards ended up telling one story',
					]}
				/>
			</CompanyCard>

			{/* Education joins the same timeline the employers share — same card,
			    same anatomy: the degree sits where a role would. */}
			<div class="connector" aria-hidden="true"></div>

			<CompanyCard
				name="University of Vermont"
				dates="2022"
				location="Burlington, VT"
				logo={uvmShield}
			>
				<RoleEntry
					last
					title="B.S. Computer Science"
					bullets={['Minor in Statistics', 'Magna cum laude']}
				/>
			</CompanyCard>
		</section>

		<section class="section">
			<SectionTitle>Writing</SectionTitle>

			{
				featured && (
					<FeaturedPostCard
						title={featured.data.title}
						href={`/blog/${featured.id}/`}
						excerpt={featured.data.description}
						date={formatPostDate(featured.data.pubDate)}
						tags={chips(featured.data.tags)}
						draft={featured.data.draft}
						placeholder="post hero image"
						{...hero}
					/>
				)
			}

			{/* Month precision: rows sit under a card that carries the exact date.
			    PostListItem closes its own group, so the rows need no divider prop. */}
			<div class="rows">
				{
					recent.map((post) => (
						<PostListItem
							compact
							title={post.data.title}
							href={`/blog/${post.id}/`}
							date={formatPostDate(post.data.pubDate, 'month')}
							tags={chips(post.data.tags)}
							draft={post.data.draft}
						/>
					))
				}
			</div>

			<a class="more" href="/blog/">all posts <MoveRight size={14} /></a>
		</section>
	</div>
</BaseLayout>

<style>
	.page {
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
	}

	.hero {
		display: flex;
		align-items: center;
		gap: var(--space-7);
	}

	.portrait {
		flex: none;
		width: 150px;
		height: 150px;
		border: var(--border-w) solid var(--border-strong);
		border-radius: var(--radius-card);
		box-shadow: var(--shadow-photo);
		object-fit: cover;
	}

	.greeting {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	h1 {
		color: var(--ink);
		font-family: var(--font-display);
		font-size: var(--text-hero);
		font-weight: var(--weight-voice);
		letter-spacing: var(--tracking-display);
		line-height: var(--leading-tight);
	}

	/* Highlighter stroke: the gradient starts partway up the line, so the ink
	   sits on the word rather than boxing it. */
	.mark {
		background: linear-gradient(transparent 64%, var(--highlight) 64%);
	}

	.intro {
		/* Measure: the intro reads as three short lines beside the portrait. */
		max-width: 440px;
		color: var(--text-body);
		font-family: var(--font-body);
		font-size: var(--text-article);
		line-height: var(--leading-body);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
	}

	.section {
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
	}

	.connector {
		display: flex;
		justify-content: center;
		/* Pulls the dotted run tight against both cards, inside the section gap. */
		height: 22px;
		margin: calc(-1 * var(--space-1)) 0;
	}

	.connector::before {
		content: '';
		border-left: 2.5px dotted var(--rail);
	}

	.rows {
		display: flex;
		flex-direction: column;
	}

	.more {
		display: flex;
		align-items: center;
		gap: var(--space-1);
		width: fit-content;
		color: var(--link);
		font-family: var(--font-display);
		font-size: var(--text-small);
		font-weight: var(--weight-title);
		text-decoration: none;
	}

	/* Portrait and greeting stop fitting side by side before the column does. */
	@media (max-width: 40rem) {
		.hero {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
