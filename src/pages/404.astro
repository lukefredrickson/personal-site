---
import { House, MoveRight } from '@lucide/astro';
import Button from '../components/Button.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

// Astro's reserved 404 route: the static build emits `dist/404.html`, which the
// Worker's `not_found_handling: "404-page"` serves — with a real 404 status —
// on every unmatched path. No adapter, no Worker code (ADR 0001).
---

<BaseLayout
	title="Page not found"
	description="That URL doesn't lead anywhere on this site. Head back to the home page, or browse everything I've written."
>
	<section class="not-found">
		{/* The heading is "Page not found"; the numeral is the graphic. */}
		<p class="numeral"><span class="mark">404</span></p>
		<h1 class="title">Page not found</h1>
		<p class="copy">This page doesn't exist — or never did.</p>
		<div class="actions">
			<Button variant="primary" href="/">home <House size={13} /></Button>
			<Button href="/blog/">blog <MoveRight size={13} /></Button>
		</div>
	</section>
</BaseLayout>

<style>
	.not-found {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-4);
		/* The screen is one short stack, so it buys its own air rather than
		   inheriting the section rhythm the content pages set. */
		padding-block: var(--space-8);
		text-align: center;
	}

	.numeral {
		color: var(--ink);
		font-family: var(--font-display);
		/* No job token covers a numeral used as artwork. */
		font-size: var(--font-size-4xl);
		font-weight: var(--weight-voice);
		letter-spacing: var(--tracking-display);
		line-height: var(--leading-tight);
	}

	/* The Home hero's highlighter stroke: the gradient starts partway up the
	   line, so the ink sits on the digits rather than boxing them. */
	.mark {
		background: linear-gradient(transparent 64%, var(--highlight) 64%);
	}

	.title {
		color: var(--ink);
		font-family: var(--font-display);
		font-size: var(--text-section);
		font-weight: var(--weight-voice);
		letter-spacing: var(--tracking-display);
	}

	.copy {
		color: var(--text-body);
		font-family: var(--font-body);
		font-size: var(--text-article);
		line-height: var(--leading-body);
	}

	.actions {
		display: flex;
		/* Both escape routes stay reachable when the row outgrows a phone. */
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-3);
		margin-top: var(--space-3);
	}
</style>
