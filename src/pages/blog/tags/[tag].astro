---
import type { InferGetStaticPropsType } from 'astro';
import BlogIndexLayout from '../../../layouts/BlogIndexLayout.astro';
import { getPublishedPosts } from '../../../lib/posts';
import { getTagCounts } from '../../../lib/tags';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();

	// A page per tag in use (ADR 0014); the pill row uses the same call.
	// Each page takes the whole list; the layout filters, the counts cover the blog.
	return getTagCounts(posts).map(({ tag }) => ({ params: { tag }, props: { tag, posts } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { tag, posts } = Astro.props;
---

<BlogIndexLayout {posts} activeTag={tag} />
